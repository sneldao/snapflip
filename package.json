{
  "name": "snapflip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build:studio",
    "dev": "wrangler dev",
    "predeploy": "npm run build:studio",
    "deploy": "wrangler deploy",
    "precheck": "npm run build:studio",
    "check": "npm run check:studio && tsc --noEmit && wrangler deploy --dry-run --outdir=dist",
    "check:studio": "tsc --noEmit --target ES2022 --module ES2022 --moduleResolution bundler --lib ES2022,DOM --strict --skipLibCheck src/studio/client.ts",
    "build:studio": "esbuild src/studio/client.ts --bundle --minify --format=esm --target=es2022 --splitting --outdir=public/app",
    "db:local": "wrangler d1 execute snapflip --local --file=schema.sql && wrangler d1 execute snapflip --local --file=seed.sql",
    "db:remote": "wrangler d1 execute snapflip --remote --file=schema.sql && wrangler d1 execute snapflip --remote --file=seed.sql",
    "tg:webhook": "node scripts/set-webhook.mjs",
    "tg:profile": "node scripts/set-bot-profile.mjs",
    "prepare": "husky",
    "test": "node --test \"tests/**/*.test.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "agents": "0.24.0",
    "hono": "4.13.10",
    "qrcode": "1.5.4",
    "stripe": "22.6.2",
    "three": "0.186.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260928.1",
    "@eslint/js": "10.0.1",
    "@types/qrcode": "1.5.5",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "wrangler": "4.143.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": [
      "eslint --max-warnings=0"
    ]
  }
}
